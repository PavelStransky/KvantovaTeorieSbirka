Cell["Angular part", "Item",
 CellChangeTimes->{{3.797492363964933*^9, 
  3.7974923782691*^9}},ExpressionUUID->"68cc23e8-639a-459a-9e98-04797d59518f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"a", "=", 
  RowBox[{"8", 
   SuperscriptBox["\[Pi]", "2"], 
   RowBox[{"Integrate", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"Sin", "[", "t", "]"}], 
      SqrtBox[
       RowBox[{
        SuperscriptBox["r1", "2"], "+", 
        SuperscriptBox["r2", "2"], "-", 
        RowBox[{"2", "r1", " ", "r2", " ", 
         RowBox[{"Cos", "[", "t", "]"}]}]}]]], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "\[Pi]"}], "}"}], ",", 
     RowBox[{"Assumptions", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"r1", ">", "0"}], ",", 
        RowBox[{"r2", ">", "0"}], ",", 
        RowBox[{"r1", "\[NotEqual]", " ", "r2"}]}], "}"}]}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.7974923860123158`*^9, 3.79749239362461*^9}, {
  3.797492599405179*^9, 3.7974926433420258`*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"fa5b3274-35b1-4e6b-9d90-37b4e6614b5a"],

Cell[BoxData[
 FractionBox[
  RowBox[{"8", " ", 
   SuperscriptBox["\[Pi]", "2"], " ", 
   RowBox[{"(", 
    RowBox[{"r1", "+", "r2", "-", 
     RowBox[{"Abs", "[", 
      RowBox[{"r1", "-", "r2"}], "]"}]}], ")"}]}], 
  RowBox[{"r1", " ", "r2"}]]], "Output",
 CellChangeTimes->{3.7974914900744247`*^9, 3.797492396871604*^9, 
  3.7974924357351737`*^9, 3.7974927510040283`*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"d5689fd9-389f-4fdd-a9df-ab6b667f9afd"]
}, Open  ]],

