Notebook[{
Cell["Radial Wave Function", "Item",
 CellChangeTimes->{{3.7974923134804015`*^9, 
  3.7974923240034575`*^9}},ExpressionUUID->"bf6834d4-758d-47d2-8549-\
1cf92b78cc5f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"R", "[", 
   RowBox[{"n_", ",", "r_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["2", 
    SuperscriptBox["n", "2"]], 
   SqrtBox[
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"n", "-", "1"}], ")"}], "!"}], 
     RowBox[{"n", "!"}]]], 
   RowBox[{"LaguerreL", "[", 
    RowBox[{
     RowBox[{"n", "-", "1"}], ",", "1", ",", 
     FractionBox[
      RowBox[{"2", "r"}], "n"]}], "]"}], 
   RowBox[{"Exp", "[", 
    FractionBox[
     RowBox[{"-", "r"}], "n"], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.7974903643323507`*^9, 3.7974903788209157`*^9}, {
  3.797490410729582*^9, 3.7974904420682125`*^9}, {3.797490486707646*^9, 
  3.797490567730631*^9}, {3.7974906502846117`*^9, 3.797490650752322*^9}, {
  3.797490779372057*^9, 3.7974907796528835`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"87399f8d-5715-40f9-9be2-112738b17da2"],

