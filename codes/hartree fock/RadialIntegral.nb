 CellChangeTimes->{{3.7974923283057995`*^9, 
  3.797492359041976*^9}},ExpressionUUID->"623224a4-ac44-4f82-bd5c-\
fe8bb46869b9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"R", "[", 
     RowBox[{"100", ",", "r"}], "]"}], 
    RowBox[{"R", "[", 
     RowBox[{"100", ",", "r"}], "]"}], 
    SuperscriptBox["r", "2"]}], ",", 
   RowBox[{"{", 
    RowBox[{"r", ",", "0", ",", "Infinity"}], "}"}]}], "]"}]], "Input",
